<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<VersionPrefix>10.30.0</VersionPrefix>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<Title>Authorize.Net API</Title>
		<Description>Authorize.Net API Checkout Handler</Description>
	</PropertyGroup>
	<PropertyGroup>
		<PackageProjectUrl>https://doc.dynamicweb.com/</PackageProjectUrl>
		<PackageTags>Dynamicweb dw10 addin commerce payment</PackageTags>
		<Product>Dynamicweb CMS</Product>
		<Company>Dynamicweb Software A/S</Company>
		<Authors>Dynamicweb Software A/S</Authors>
		<Copyright>Copyright © 2026 Dynamicweb Software A/S</Copyright>
	</PropertyGroup>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<PackageIcon>AuthorizeNet-logo.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Dynamicweb" Version="10.30.4" />
		<PackageReference Include="Dynamicweb.Core" Version="10.30.4" />
		<PackageReference Include="Dynamicweb.Ecommerce" Version="10.30.4" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Dynamicweb.Ecommerce.CheckoutHandlers.AuthorizeNetApi.Tests" />
	</ItemGroup>
	<ItemGroup>
	  <None Update="AuthorizeNet-logo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>
</Project>
